{
  "name": "dsh-advisor",
  "version": "0.2.1",
  "description": "Second-opinion consultations for DeepSeek Harness sessions: a desktop settings page, an in-session consult entry, and a live consultation card that keeps materials, model, state and verdict visible.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "advisor",
    "consultation",
    "second-opinion",
    "agent",
    "cordis"
  ],
  "author": "qiao-obs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiao-obs/dsh-advisor.git"
  },
  "bugs": {
    "url": "https://github.com/qiao-obs/dsh-advisor/issues"
  },
  "homepage": "https://github.com/qiao-obs/dsh-advisor#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0-rc.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  }
}
